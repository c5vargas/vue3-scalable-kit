{
  "name": "vue3-scalable-kit",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "lint-staged": {
    "src/**/*.{ts,js,vue,html,css}": "prettier --write",
    "src/**/*.{ts,js,vue}": "eslint --fix"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "npx eslint .",
    "release": "standard-version && git push --follow-tags --no-verify",
    "format:write": "prettier .  --write",
    "format:check": "prettier .  --check",
    "prepare": "husky install"
  },
  "dependencies": {
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.15",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-vue": "^10.3.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "3.6.2",
    "standard-version": "^9.5.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.37.0",
    "vite": "^7.0.4",
    "vue-tsc": "^2.2.12"
  }
}
